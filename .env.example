# Copie este arquivo para ".env" (na raiz do projeto) e preencha com seus valores reais.
# NUNCA cole valores reais aqui neste arquivo .env.example, e NUNCA envie o .env para o git
# (ele já está no .gitignore). As chaves "secretas" (service role / stripe secret) só devem
# existir no servidor (funções da Vercel) — nunca em variáveis com prefixo VITE_.

# ---- Supabase ----
# Painel do projeto > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-a-anon-public-key-aqui

# Usada só nas funções serverless (/api), NUNCA no código do navegador.
# Painel do projeto > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# ---- Stripe ----
# Painel Stripe > Developers > API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_ou_pk_live_aqui
STRIPE_SECRET_KEY=sk_test_ou_sk_live_aqui

# Price ID do plano mensal (Painel Stripe > Product catalog > seu produto > Pricing)
STRIPE_PRICE_ID_MONTHLY=price_xxx

# Painel Stripe > Developers > Webhooks > sua URL de endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL pública do app em produção (usada nos redirects do checkout)
VITE_APP_URL=https://seu-dominio.vercel.app
